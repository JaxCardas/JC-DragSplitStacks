<Project>
  <!-- Wspolne ustawienia dla wszystkich modow DLL w tym repo. -->
  <PropertyGroup>
    <GamePath Condition="'$(GamePath)' == '' And '$(SDTD_PATH)' != ''">$(SDTD_PATH)</GamePath>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files\.My\Steam\steamapps\common\7 Days To Die</GamePath>
    <GameManaged>$(GamePath)\7DaysToDie_Data\Managed</GameManaged>
    <ModOutputRoot>$(MSBuildThisFileDirectory)_build</ModOutputRoot>

    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <!-- Mody nie powinny niczego kopiowac ani wymagac z NuGet poza assembly referencyjnymi. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(GameManaged)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LogLibrary" Condition="Exists('$(GameManaged)\LogLibrary.dll')"><HintPath>$(GameManaged)\LogLibrary.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GameManaged)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="NGUI"><HintPath>$(GameManaged)\NGUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="InControl"><HintPath>$(GameManaged)\InControl.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GamePath)\Mods\0_TFP_Harmony\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Po buildzie skladamy gotowy folder moda w _build\<NazwaProjektu>\ (DLL + ModInfo.xml + Config + Resources + UIAtlases). -->
  <Target Name="AssembleModFolder" AfterTargets="Build">
    <PropertyGroup>
      <ModDir>$(ModOutputRoot)\$(MSBuildProjectName)</ModDir>
    </PropertyGroup>
    <ItemGroup>
      <ModContent Include="Config\**\*;Resources\**\*;UIAtlases\**\*;Prefabs\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(ModDir)" />
    <Copy SourceFiles="$(TargetPath);ModInfo.xml" DestinationFolder="$(ModDir)" />
    <Copy SourceFiles="README.md" DestinationFolder="$(ModDir)" Condition="Exists('README.md')" />
    <!-- Sciezka wzgledna (np. Config\blocks.xml) zachowuje strukture folderow. -->
    <Copy SourceFiles="@(ModContent)" DestinationFiles="@(ModContent->'$(ModDir)\%(Identity)')" />
    <Message Importance="high" Text="Mod zlozony w: $(ModDir)" />
  </Target>
</Project>
